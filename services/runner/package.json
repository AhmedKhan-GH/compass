{
  "name": "@compass/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "images": "tsx src/build-images.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"test/**/!(*.docker).test.ts\"",
    "test:docker": "node --import tsx --test --test-concurrency=1 \"test/**/*.docker.test.ts\""
  },
  "dependencies": {
    "@compass/schema": "*"
  }
}
